# Copy to apps/web/.env.local (never commit real values)
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...anon-public-key...
VITE_APP_NAME=BizDemo SMS
# Telegram bot username (without @) — used for the "Link Telegram" deep link
VITE_TELEGRAM_BOT=Oneteam_app_bot
# Edge Functions (set with: npx supabase secrets set KEY=value) — never in this file's real copy
# TELEGRAM_BOT_TOKEN=            (from @BotFather — revoke + regenerate if it was ever pasted anywhere)
# TELEGRAM_BOT_USERNAME=Oneteam_app_bot
# TELEGRAM_WEBHOOK_SECRET=       (random 32+ chars; same value passed to setWebhook secret_token)
# CRON_SECRET=                   (random 32+ chars; header x-cron-secret used by the telegram-sender cron)
# ALLOWED_ORIGINS=http://localhost:5173,https://oneteam.bizdemo.app,https://staging.bizdemo.app
# AUTH_EMAIL_DOMAIN=users.bizdemo.app
