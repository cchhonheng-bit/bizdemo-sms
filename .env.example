# /opt/oneteam/.env — the ONLY place for secrets on the server (chmod 600, never in git, never in chat). Rule 6.4.
DOMAIN=oneteam.bizdemo.app
ACME_EMAIL=it@example.com
APP_NAME=One Team Service

# PostgreSQL password for the app (generate: openssl rand -base64 24)
DB_PASSWORD=change-me-generate-a-long-random-value

# Cookie signing key, at least 32 characters (generate: openssl rand -base64 32)
SESSION_SECRET=change-me-generate-a-long-random-value

# Telegram (from @BotFather). Webhook secret: openssl rand -hex 24
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Oneteam_app_bot
TELEGRAM_WEBHOOK_SECRET=
