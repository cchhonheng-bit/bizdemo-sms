#!/usr/bin/env bash
# git hook on the VPS (/opt/oneteam.git/hooks/post-receive): runs on every `deploy.cmd` (git push vps main).
# Order (owner condition 1, 29-09): checkout → BACKUP (fail = stop) → build + restart → health check.
set -euo pipefail
APP=/opt/oneteam
REPO=/opt/oneteam.git
while read -r _old new ref; do
  [ "$ref" = "refs/heads/main" ] || continue
  echo "==> checkout ${new:0:7}"
  git --work-tree="$APP" --git-dir="$REPO" checkout -f main
  cd "$APP"
  cp deploy/post-receive "$REPO/hooks/post-receive" && chmod +x "$REPO/hooks/post-receive" deploy/*.sh   # hook updates itself
  [ -f .env ] || { echo "!! /opt/oneteam/.env is missing — copy .env.example and fill it (SERVER_SETUP.md step 5)"; exit 1; }
  echo "==> backup before deploy"
  ./deploy/backup.sh || { echo "!! BACKUP FAILED — deploy stopped, nothing changed"; exit 1; }
  echo "==> build + restart (2–3 minutes)"
  docker compose up -d --build --remove-orphans
  echo "==> health check"
  ok=""
  for _ in $(seq 1 45); do
    sleep 2
    if docker compose exec -T app wget -qO- http://localhost:3000/healthz >/dev/null 2>&1; then ok=1; break; fi
  done
  if [ -z "$ok" ]; then docker compose logs app --tail 80; echo "!! HEALTH CHECK FAILED — check the log above (previous image is still available: docker image ls)"; exit 1; fi
  docker image prune -f >/dev/null 2>&1 || true
  echo "==> deployed ${new:0:7} · https://$(grep -E '^DOMAIN=' .env | cut -d= -f2)"
done
