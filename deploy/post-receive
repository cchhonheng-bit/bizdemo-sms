#!/usr/bin/env bash
# git hook on the VPS (/opt/oneteam.git/hooks/post-receive): runs on every `deploy.cmd` (git push vps main).
# Order (owner condition 1, 29-09): checkout → BACKUP (fail = stop) → build + restart → health check.
set -euo pipefail
APP=/opt/oneteam
REPO=/opt/oneteam.git
while read -r _old new ref; do
  [ "$ref" = "refs/heads/main" ] || continue
  echo "==> checkout ${new:0:7}"
  git --work-tree="$APP" --git-dir="$REPO" checkout -f main
  cd "$APP"
  chmod +x deploy/*.sh deploy/post-receive
  # the hook updates itself atomically (a running bash must never see its own file change in place)
  if ! cmp -s deploy/post-receive "$REPO/hooks/post-receive"; then cp deploy/post-receive "$REPO/hooks/post-receive.new" && chmod +x "$REPO/hooks/post-receive.new" && mv -f "$REPO/hooks/post-receive.new" "$REPO/hooks/post-receive"; fi
  [ -f .env ] || { echo "!! /opt/oneteam/.env is missing — copy .env.example and fill it (SERVER_SETUP.md step 5)"; exit 1; }
  echo "==> backup before deploy"
  ./deploy/backup.sh </dev/null || { echo "!! BACKUP FAILED — deploy stopped, nothing changed"; exit 1; }
  echo "==> build + restart (2–3 minutes)"
  docker compose up -d --build --remove-orphans </dev/null
  docker compose exec -T caddy caddy reload --config /etc/caddy/Caddyfile </dev/null >/dev/null 2>&1 || true   # Caddyfile is bind-mounted
  echo "==> health check"
  ok=""
  for _ in $(seq 1 45); do
    sleep 2
    if docker compose exec -T app wget -qO- http://127.0.0.1:3000/healthz </dev/null >/dev/null 2>&1; then ok=1; break; fi
  done
  if [ -z "$ok" ]; then docker compose logs app --tail 80 </dev/null; echo "!! HEALTH CHECK FAILED — check the log above · rollback: git push vps <previous-tag>:main --force"; exit 1; fi
  docker image prune -f >/dev/null 2>&1 || true
  echo "==> deployed ${new:0:7} · https://$(grep -E '^DOMAIN=' .env | cut -d= -f2)"
done
