# Caddy: automatic HTTPS (Let's Encrypt) for every HangKH domain, HTTP→HTTPS, security headers, /internal/* closed.
# (common) takes one argument: extra script-src sources ("" = none). D-93: the shop host allows Telegram's Mini App script only.
{
	email {$ACME_EMAIL}
	# D-84: port 443 also carries SSH for networks that block port 22. layer4 sees the plain "SSH-" greeting before any
	# TLS and hands the connection to the host's sshd; everything else continues as normal HTTPS in this same Caddy
	# process, so the apps keep the real client IP (rate limits, audit).
	servers :443 {
		listener_wrappers {
			layer4 {
				@ssh ssh
				route @ssh {
					proxy host.docker.internal:22
				}
			}
			tls
		}
	}
}

(common) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(self), camera=(self), microphone=(), payment=()"
		Content-Security-Policy "default-src 'self'; connect-src 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'{args[0]}; worker-src 'self'; frame-src https://maps.google.com https://www.google.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
	# hub ⇄ shop API is for the internal network only (D-51)
	respond /internal/* 404
}

{$DOMAIN_HUB} {
	import common ""
	reverse_proxy app-hub:3000
}

{$DOMAIN_ONETEAM} {
	import common " https://telegram.org"
	reverse_proxy app-oneteam:3000
}

{$DOMAIN_ROOT}, www.{$DOMAIN_ROOT} {
	redir https://{$DOMAIN_HUB}{uri} 302
}
