# =============================================================================
#  PRODUCTION (deploy.cmd, D-37) -> template for  .env.prod.local  (optional).
#  Create it with:  node scripts\env-file.mjs prod   (user-only permissions, SETUP_LOCAL.md step 8)
#  Public production values (project ref, URL, publishable key, Pages project)
#  are fixed in environments.json and cannot be changed here.
# =============================================================================

# Database password of the PRODUCTION project (Supabase -> Project Settings -> Database).
# Recommended: leave EMPTY -> the Supabase CLI asks for it during each deploy, so it is never stored on disk.
SUPABASE_DB_PASSWORD=

# Only if your Cloudflare login has more than one account:
# Cloudflare dashboard -> Workers & Pages -> right sidebar "Account ID" (not a secret).
CLOUDFLARE_ACCOUNT_ID=
