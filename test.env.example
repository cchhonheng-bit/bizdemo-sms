# =============================================================================
#  TEST project (Local = Test, D-37) -> template for  .env.test.local  (test-local.cmd creates it).
#  .env.test.local is gitignored and never leaves your PC.
#  NEVER put PRODUCTION values here: test-local.cmd, seed-test and `pnpm dev`
#  refuse to run if anything in this file points at production.
# =============================================================================

# Supabase TEST project "bizdemo-test" -> Project Settings -> General -> Project ID (20 letters)
SUPABASE_PROJECT_REF=

# Project Settings -> API Keys -> Publishable key (sb_publishable_...; public, used by the web app)
SUPABASE_PUBLISHABLE_KEY=

# Database password you chose when creating the TEST project (used by `supabase db push`).
# Leave empty to type it when the Supabase CLI asks.
SUPABASE_DB_PASSWORD=

# Project Settings -> API Keys -> Secret keys -> "+ New secret key" named "seed" (sb_secret_...).
# Used ONLY by scripts/seed-test.mjs to create the test company + accounts. Never used by the web app.
SEED_SECRET_KEY=

# One password (at least 10 characters) for ALL test accounts: ceo, gm01, admin, kim, dara, heng
TEST_PASSWORD=

# Optional: username (without @) of a separate TEST Telegram bot. Leave empty if Telegram is not tested.
TELEGRAM_BOT=
